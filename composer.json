{
    "name": "school/tradelog",
    "description": "TradeLog - a futures trading journal (school project, Laravel 12)",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
