# Settings of the website. start.bat copies this file to ".env" the first time.

APP_NAME=TradeLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database = MySQL from XAMPP. XAMPP's user is "root" with an empty password.
# The "tradelog" database is created automatically by start.bat.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradelog
DB_USERNAME=root
DB_PASSWORD=

# Logged-in users are remembered in files in storage/framework/sessions
SESSION_DRIVER=file
CACHE_STORE=file
